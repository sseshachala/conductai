{
  "name": "mcp_new_guard_tools_list",
  "description": "New /mcp tools/list surfaces guard MCP tools registered via ToolRegistry — proves Phase 3b Chunk B guard registrations wire in.",
  "requires_db": true,
  "request": {
    "method": "POST",
    "path": "/mcp",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {token}"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 31,
      "method": "tools/list",
      "params": {}
    }
  },
  "expected_response": {
    "status": 200,
    "body_match": {
      "jsonrpc": "2.0",
      "id": 31
    },
    "custom_assertions": [
      {"kind": "tools_include", "names": ["guard_status", "guard_check", "guard_sync", "guard_activity", "conduct_list_agents", "conduct_list_projects", "conduct_list_playbooks", "conduct_run_workflow", "conduct_get_run", "post_finding", "trigger_fix"]}
    ]
  }
}
