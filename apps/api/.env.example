# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marshal

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ──────────────────────────────────────────────────────────────────
# Must be a 32-byte random string in non-dev environments
ENCRYPTION_KEY=dev-only-32-byte-key-change-this!
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * only in local dev)
ALLOWED_ORIGINS=http://localhost:3000,https://conductai.ai

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Required in all non-dev environments — disables JWT verification if unset
CLERK_FRONTEND_API=your-clerk-subdomain.clerk.accounts.dev
CLERK_AUDIENCE=your-clerk-audience
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# ── App URLs ─────────────────────────────────────────────────────────────────
APP_URL=https://conductai.ai
API_BASE_URL=https://api.conductai.ai

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...           # used by memory/embedding blocks
VOYAGE_API_KEY=pa-...           # used by agent-booster vector search

# ── Inference (GLens + NLP policy authoring) — Render API + Worker only ─────
CONDUCT_INFERENCE_ENDPOINT_URL=https://org--model-name.modal.run/v1
CONDUCT_INFERENCE_MODEL_NAME=qwen3-235b-a3b
CONDUCT_INFERENCE_TOKEN_ID=                  # Modal token ID
CONDUCT_INFERENCE_TOKEN_SECRET=              # Modal token secret

# ── Guard Proxy ───────────────────────────────────────────────────────────────
CONDUCT_PROXY_URL=https://api.conductai.ai/proxy
CONDUCT_LLM_UPSTREAM=https://api.anthropic.com

# ── Webhooks ──────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret

# ── Server-to-server auth ─────────────────────────────────────────────────────
# Used by CLI and internal services — generate with: openssl rand -hex 32
CLI_API_KEY=your_cli_api_key

# ── Workspace defaults (local dev only) ───────────────────────────────────────
CLI_WORKSPACE_ID=
