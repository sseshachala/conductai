{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conduct tool catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_check_statuses",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gateway_check_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "connection_verified",
          "authentication_failed",
          "unavailable"
        ]
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "executable",
          "surfaces",
          "gateway",
          "setup_ui",
          "live_acceptance",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "gateway": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "operation"
                ],
                "properties": {
                  "provider": {
                    "enum": [
                      "anthropic",
                      "openai"
                    ]
                  },
                  "operation": {
                    "enum": [
                      "anthropic_messages",
                      "openai_responses"
                    ]
                  }
                }
              }
            ]
          },
          "setup_ui": {
            "type": "boolean"
          },
          "live_acceptance": {
            "enum": [
              "pending",
              "verified"
            ]
          },
          "adapter": {
            "$ref": "#/$defs/adapter"
          }
        }
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platforms",
        "home",
        "home_env",
        "mcp",
        "hooks",
        "usage"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          }
        },
        "home": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        },
        "home_env": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          ]
        },
        "mcp": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/configSource"
          }
        },
        "hooks": {
          "enum": [
            null,
            "claude",
            "codex",
            "cursor",
            "windsurf",
            "copilot"
          ]
        },
        "usage": {
          "enum": [
            null,
            "claude-jsonl",
            "codex-jsonl",
            "copilot-jsonl"
          ]
        }
      }
    },
    "configSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "path",
        "scope",
        "key"
      ],
      "properties": {
        "anchor": {
          "enum": [
            "root",
            "root-sibling",
            "project"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
        },
        "scope": {
          "enum": [
            "user",
            "legacy-user",
            "project"
          ]
        },
        "key": {
          "enum": [
            "mcpServers",
            "mcp_servers"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "anchor": {
                "const": "project"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": "project"
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "enum": [
                  "user",
                  "legacy-user"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "anchor": {
                "const": "root-sibling"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "const": ".json"
              }
            }
          }
        }
      ]
    }
  }
}
