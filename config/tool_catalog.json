{
  "schema_version": 1,
  "gateway_check_statuses": [
    "connection_verified",
    "authentication_failed",
    "unavailable"
  ],
  "tools": [
    {
      "id": "claude-code",
      "label": "Claude Code",
      "executable": "claude",
      "surfaces": [
        "claude-code"
      ],
      "gateway": {
        "provider": "anthropic",
        "operation": "anthropic_messages"
      },
      "setup_ui": true,
      "live_acceptance": "pending",
      "adapter": {
        "version": 1,
        "platforms": [
          "darwin",
          "linux",
          "win32"
        ],
        "home": [
          ".claude"
        ],
        "home_env": "CLAUDE_CONFIG_DIR",
        "mcp": [
          {
            "anchor": "root",
            "path": "settings.json",
            "scope": "legacy-user",
            "key": "mcpServers"
          },
          {
            "anchor": "root-sibling",
            "path": ".json",
            "scope": "user",
            "key": "mcpServers"
          },
          {
            "anchor": "project",
            "path": ".mcp.json",
            "scope": "project",
            "key": "mcpServers"
          }
        ],
        "hooks": "claude",
        "usage": "claude-jsonl"
      }
    },
    {
      "id": "codex",
      "label": "Codex",
      "executable": "codex",
      "surfaces": [
        "codex-cli",
        "codex-desktop"
      ],
      "gateway": {
        "provider": "openai",
        "operation": "openai_responses"
      },
      "setup_ui": true,
      "live_acceptance": "pending",
      "adapter": {
        "version": 1,
        "platforms": [
          "darwin",
          "linux",
          "win32"
        ],
        "home": [
          ".codex"
        ],
        "home_env": "CODEX_HOME",
        "mcp": [
          {
            "anchor": "root",
            "path": "config.toml",
            "scope": "user",
            "key": "mcp_servers"
          },
          {
            "anchor": "project",
            "path": ".codex/config.toml",
            "scope": "project",
            "key": "mcp_servers"
          }
        ],
        "hooks": "codex",
        "usage": "codex-jsonl"
      }
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "executable": "cursor",
      "surfaces": [
        "cursor"
      ],
      "gateway": null,
      "setup_ui": true,
      "live_acceptance": "pending",
      "adapter": {
        "version": 1,
        "platforms": [
          "darwin",
          "linux",
          "win32"
        ],
        "home": [
          ".cursor"
        ],
        "home_env": null,
        "mcp": [
          {
            "anchor": "root",
            "path": "mcp.json",
            "scope": "user",
            "key": "mcpServers"
          },
          {
            "anchor": "project",
            "path": ".cursor/mcp.json",
            "scope": "project",
            "key": "mcpServers"
          }
        ],
        "hooks": "cursor",
        "usage": null
      }
    },
    {
      "id": "windsurf",
      "label": "Windsurf",
      "executable": "windsurf",
      "surfaces": [
        "windsurf"
      ],
      "gateway": null,
      "setup_ui": true,
      "live_acceptance": "pending",
      "adapter": {
        "version": 1,
        "platforms": [
          "darwin",
          "linux",
          "win32"
        ],
        "home": [
          ".codeium",
          "windsurf"
        ],
        "home_env": null,
        "mcp": [
          {
            "anchor": "root",
            "path": "mcp_config.json",
            "scope": "user",
            "key": "mcpServers"
          }
        ],
        "hooks": "windsurf",
        "usage": null
      }
    },
    {
      "id": "copilot-cli",
      "label": "Copilot CLI",
      "executable": "copilot",
      "surfaces": [
        "copilot-cli"
      ],
      "gateway": {
        "provider": "openai",
        "operation": "openai_responses"
      },
      "setup_ui": true,
      "live_acceptance": "pending",
      "adapter": {
        "version": 1,
        "platforms": [
          "darwin",
          "linux",
          "win32"
        ],
        "home": [
          ".copilot"
        ],
        "home_env": "COPILOT_HOME",
        "mcp": [
          {
            "anchor": "root",
            "path": "mcp-config.json",
            "scope": "user",
            "key": "mcpServers"
          }
        ],
        "hooks": "copilot",
        "usage": "copilot-jsonl"
      }
    }
  ]
}
