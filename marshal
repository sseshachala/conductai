#!/usr/bin/env python3
"""
Marshal CLI — run a workflow from a YAML file in one shot.

Usage:
  ./marshal run autopilot.yaml
  ./marshal run autopilot.yaml --api-url http://localhost:8000
  ./marshal run autopilot.yaml --token <clerk_jwt>

What it does:
  1. Reads the YAML
  2. Finds the workflow by name (or creates it)
  3. Pushes the YAML as the current version
  4. Creates a run (injecting state from the YAML's `test:` block)
  5. Streams block-by-block events until the run completes or fails
"""
import argparse
import json
import sys
import urllib.request
import urllib.error
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: pyyaml not installed.  pip install pyyaml")
    sys.exit(1)

DEV_WORKSPACE = "00000000-0000-0000-0000-000000000001"
DEFAULT_API    = "http://localhost:8000"

RESET = "\033[0m"
BOLD  = "\033[1m"
GREEN = "\033[32m"
RED   = "\033[31m"
BLUE  = "\033[34m"
GRAY  = "\033[90m"


def _req(method: str, url: str, headers: dict, body=None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    req  = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        raw = e.read().decode()
        try:
            detail = json.loads(raw).get("detail", raw)
        except Exception:
            detail = raw
        print(f"{RED}HTTP {e.code}: {detail}{RESET}")
        sys.exit(1)


def _req_text(method: str, url: str, headers: dict, body_text: str) -> dict:
    data = body_text.encode()
    req  = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        raw = e.read().decode()
        try:
            detail = json.loads(raw).get("detail", raw)
        except Exception:
            detail = raw
        print(f"{RED}HTTP {e.code}: {detail}{RESET}")
        sys.exit(1)


def _stream(url: str):
    """Minimal SSE reader — yields parsed data dicts."""
    req = urllib.request.Request(url)
    try:
        resp = urllib.request.urlopen(req)
    except urllib.error.HTTPError as e:
        print(f"{RED}Stream error {e.code}: {e.read().decode()}{RESET}")
        sys.exit(1)

    buf = b""
    while True:
        chunk = resp.read(1)
        if not chunk:
            break
        buf += chunk
        if buf.endswith(b"\n\n"):
            block_text = buf.decode().strip()
            buf = b""
            event = "message"
            for line in block_text.splitlines():
                if line.startswith("event:"):
                    event = line[6:].strip()
                elif line.startswith("data:"):
                    data_str = line[5:].strip()
                    try:
                        data = json.loads(data_str)
                    except json.JSONDecodeError:
                        data = {"raw": data_str}
                    data.setdefault("kind", event)
                    yield data


def _find_or_create_workflow(api: str, name: str, headers: dict) -> str:
    """Return workflow ID — look up by name, create if missing."""
    workflows = _req("GET", f"{api}/workflows", headers)
    for wf in workflows:
        if wf["name"] == name:
            return wf["id"]

    # Not found — create it with an empty graph; YAML push will set the real version
    wf = _req("POST", f"{api}/workflows", headers, {
        "name": name,
        "graph": {"nodes": [], "edges": []},
    })
    return wf["id"]


def cmd_run(args):
    path = Path(args.yaml)
    if not path.exists():
        print(f"ERROR: file not found: {path}")
        sys.exit(1)

    with open(path) as f:
        raw_yaml = f.read()

    cfg = yaml.safe_load(raw_yaml)

    name         = cfg.get("name", path.stem)
    api          = (args.api_url or cfg.get("api_url") or DEFAULT_API).rstrip("/")
    workspace_id = cfg.get("workspace_id") or DEV_WORKSPACE
    test_state   = cfg.get("test", {}).get("state") or {}

    json_headers = {
        "Content-Type":   "application/json",
        "X-Workspace-Id": workspace_id,
    }
    yaml_headers = {
        "Content-Type":   "application/x-yaml",
        "X-Workspace-Id": workspace_id,
    }
    if args.token:
        json_headers["Authorization"] = yaml_headers["Authorization"] = f"Bearer {args.token}"

    # ── 1. Find or create workflow ────────────────────────────────────────────
    print(f"{BOLD}▶ marshal run — {name}{RESET}")
    print(f"  API: {api}")
    workflow_id = _find_or_create_workflow(api, name, json_headers)
    print(f"  Workflow ID: {workflow_id}")

    # ── 2. Push YAML as new version ───────────────────────────────────────────
    print(f"  Pushing YAML…", end=" ", flush=True)
    _req_text("PUT", f"{api}/workflows/{workflow_id}/yaml", yaml_headers, raw_yaml)
    print(f"{GREEN}done{RESET}")

    # ── 3. Create run ─────────────────────────────────────────────────────────
    run_body = {"triggered_by": "cli", "initial_state": test_state}
    if test_state:
        print(f"  State keys: {list(test_state.keys())}")

    run = _req("POST", f"{api}/workflows/{workflow_id}/runs", json_headers, run_body)
    run_id = run["id"]
    print(f"  Run ID: {run_id}\n")

    # ── 4. Stream events ──────────────────────────────────────────────────────
    qs = f"?workspace_id={workspace_id}"
    if args.token:
        qs += f"&token={args.token}"
    stream_url = f"{api}/workflows/{workflow_id}/runs/{run_id}/stream{qs}"

    terminal = {"run_completed", "run_failed"}

    for data in _stream(stream_url):
        kind     = data.get("kind", "")
        block_id = data.get("block_id") or ""
        payload  = data.get("payload", data)
        prefix   = f"[{block_id}] " if block_id else ""

        if kind == "block_started":
            label = payload.get("label") or payload.get("type", "")
            print(f"{BLUE}  ▶ {prefix}{label}{RESET}")

        elif kind == "block_completed":
            summary = payload.get("summary") or json.dumps(payload, default=str)[:120]
            print(f"{GREEN}  ✓ {prefix}{summary}{RESET}")

        elif kind == "block_failed":
            err = payload.get("error", json.dumps(payload, default=str)[:200])
            print(f"{RED}  ✗ {prefix}{err}{RESET}")

        elif kind == "run_completed":
            print(f"\n{BOLD}{GREEN}✓ Run completed{RESET}\n")

        elif kind == "run_failed":
            err = payload.get("error", "")
            print(f"\n{BOLD}{RED}✗ Run failed: {err}{RESET}\n")
            sys.exit(1)

        else:
            print(f"{GRAY}  {kind}: {json.dumps(payload, default=str)[:140]}{RESET}")

        if kind in terminal:
            break


def main():
    parser = argparse.ArgumentParser(prog="marshal", description="Marshal workflow CLI")
    sub    = parser.add_subparsers(dest="command")

    run_p = sub.add_parser("run", help="Run a workflow from a YAML file")
    run_p.add_argument("yaml",      help="Path to workflow YAML")
    run_p.add_argument("--api-url", help="API base URL (overrides YAML api_url field)")
    run_p.add_argument("--token",   help="Bearer token for Clerk auth")

    args = parser.parse_args()
    if args.command == "run":
        cmd_run(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
