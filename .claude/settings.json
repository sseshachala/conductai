{
  "permissions": {
    "allow": [
      "Bash(conduct)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "mcp__agent-booster__get_symbols",
      "mcp__agent-booster__route_model",
      "mcp__agent-booster__search_context",
      "mcp__agent-booster__smart_read",
      "mcp__claude_ai_Conduct_AI__guard_activity",
      "mcp__claude_ai_Conduct_AI__guard_check",
      "mcp__conduct__conduct_get_run",
      "mcp__plugin_vercel_vercel__list_deployments",
      "mcp__plugin_vercel_vercel__list_projects"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/sudhiseshachala/projects/marshal/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/validate-playbooks.py\"'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/booster-gate.py\"'"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/booster-grep-nudge.py\"'"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/booster-agent-inject.py\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/booster-route.py\"'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/sudhiseshachala/projects/marshal/.claude/hooks/guard-precompact.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-session-start.py\"'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/booster-session-start.py\"'",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sudhiseshachala/Library/Python/3.9/bin/conduct guard sync || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/booster-stop.py\"'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}